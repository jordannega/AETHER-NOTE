                    <button class="tool-btn" data-command="formatBlock" data-value="BLOCKQUOTE" title="Quote Block"><i class="fa-solid fa-quote-right"></i></button>
                    <button class="tool-btn" data-command="formatBlock" data-value="PRE" title="Code Block"><i class="fa-solid fa-code"></i></button>
