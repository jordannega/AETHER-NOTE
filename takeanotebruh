    <!-- ============================================================
         DELETE MODAL
         ============================================================ -->
    <div class="modal-overlay" id="deleteModal">
        <div class="cyber-modal">
            <div class="modal-title">
                <i class="fa-solid fa-triangle-exclamation"></i>
