                <button class="btn-secondary" id="cancelDeleteBtn">CANCEL</button>
                <button class="btn-danger" id="confirmDeleteBtn">PURGE</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
         SCRIPTS
         ============================================================ -->
    <script>
        // ============================================================
        // GOD TIER AETHER ENGINE
        // ============================================================

        (function() {
            'use strict';

            // ------------------------------------------------------------
            // CONFIGURATION
            // ------------------------------------------------------------
            const STORAGE_KEY = 'AETHER_GODTIER_DATA_V2';
            const MAX_VERSIONS = 20;
            const AUTO_SAVE_DELAY = 600;
            const DEBOUNCE_DELAY = 100;

            // ------------------------------------------------------------
            // STATE
            // ------------------------------------------------------------
            let state = {
                notes: [],
                currentId: null,
                filter: 'ALL',
                search: '',
                theme: 'cyber',
                isSidebarCollapsed: false,
                isFocusMode: false,
                isCommandPaletteOpen: false,
                undoStack: [],
                redoStack: [],
                saveTimer: null,
                versionMap: {}
            };

            // ------------------------------------------------------------
            // DOM REFS
            // ------------------------------------------------------------
            const $ = (sel) => document.querySelector(sel);
            const $$ = (sel) => document.querySelectorAll(sel);

            const DOM = {
                sidebar: $('#sidebar'),
                sidebarToggle: $('#sidebarToggle'),
                brandLogo: $('#brandLogo'),
                themeToggle: $('#themeToggle'),
                newNoteBtn: $('#newNoteBtn'),
                searchInput: $('#searchInput'),
                categoryFilters: $('#categoryFilters'),
                tagCloud: $('#tagCloud'),
                notesList: $('#notesList'),
                noteTitle: $('#noteTitle'),
                noteCategory: $('#noteCategory'),
                noteTags: $('#noteTags'),
                noteBody: $('#noteBody'),
                saveStatus: $('#saveStatus'),
                statusDot: $('#statusDot'),
                wordCount: $('#wordCount'),
                charCount: $('#charCount'),
                activeNoteId: $('#activeNoteId'),
                versionCount: $('#versionCount'),
                deleteModal: $('#deleteModal'),
                cancelDeleteBtn: $('#cancelDeleteBtn'),
                confirmDeleteBtn: $('#confirmDeleteBtn'),
                deleteNoteBtn: $('#deleteNoteBtn'),
                exportBtn: $('#exportBtn'),
                focusModeBtn: $('#focusModeBtn'),
                editorBody: $('#editorBody'),
                commandPalette: $('#commandPalette'),
                commandInput: $('#commandInput'),
                commandResults: $('#commandResults'),
                toastContainer: $('#toastContainer'),
                formattingToolbar: $('#formattingToolbar'),
            };

            // ------------------------------------------------------------
            // INITIALIZATION
            // ------------------------------------------------------------
            function init() {
                loadState();
                
                if (state.notes.length === 0) {
                    createSampleNotes();
                }
                
                if (!state.currentId && state.notes.length > 0) {
                    state.currentId = state.notes[0].id;
                }

                renderNotesList();
                loadActiveNote();
                renderTagCloud();
                applyTheme();
                setupEventListeners();
                setupFormattingToolbar();
                setupKeyboardShortcuts();
                setupCommandPalette();
                updateHUD();

                // Set initial sidebar state
                if (state.isSidebarCollapsed) {
                    DOM.sidebar.classList.add('collapsed');
                }

                console.log('⚡ AETHER GOD TIER initialized');
                toast('System online', 'success');
            }

            // ------------------------------------------------------------
            // SAMPLE DATA
            // ------------------------------------------------------------
            function createSampleNotes() {
                state.notes = [
                    {
                        id: 'note-101',
                        title: 'Active Directory Security Auditing & Kerberoasting',
                        category: 'CYBERSEC',
                        tags: 'AD, Kerberos, Pentest',
                        content: `<h2>Threat Overview</h2>
                        <p>Kerberoasting targets Service Principal Names (SPNs) in Active Directory. Any authenticated user can request a Kerberos TGS ticket for an SPN service account and crack the hash offline.</p>
                        <h2>Detection Vectors</h2>
                        <p>Monitor Event ID 4769 (A Kerberos service ticket was requested). Filter specifically for ticket options matching encryption type 0x17 (RC4-HMAC).</p>
                        <pre><code># Mitigation Policy Config
        Set-ADAccountPassword -Identity "sql_svc" -Reset</code></pre>
                        <blockquote>Ensure service account passwords exceed 25 characters to resist offline dictionary attacks.</blockquote>`,
                        updatedAt: new Date().toISOString(),
                        version: 1
                    },
                    {
                        id: 'note-102',
                        title: 'Tactical Chess Mastery: Rapid System Strategy',
                        category: 'RESEARCH',
                        tags: 'Chess, Tactics, Lichess',
                        content: `<h2>Target: Progressing to 1800+ Rating</h2>
                        <p>Focus on tactical pattern recognition and middle-game positional awareness.</p>
                        <ul>
                            <li>Daily 20-minute puzzle storm on Lichess</li>
                            <li>Study Queen's Gambit & King's Indian Defense setups</li>
                            <li>Minimize blunders by verifying engine tactical lines post-match</li>
                        </ul>
                        <p>Key insight: <strong>Positional sacrifices</strong> often create more winning chances than material preservation at this level.</p>`,
                        updatedAt: new Date(Date.now() - 86400000).toISOString(),
                        version: 1
                    },
                    {
                        id: 'note-103',
                        title: 'Neural Architecture: Transformer Models',
                        category: 'DEV',
                        tags: 'AI, Transformers, LLM',
                        content: `<h2>Attention Mechanism Deep Dive</h2>
                        <p>The self-attention mechanism allows the model to weigh the importance of different words in the input sequence. Key formula:</p>
                        <pre><code>Attention(Q,K,V) = softmax(QK^T / √d_k) V</code></pre>
                        <h3>Multi-Head Attention</h3>
                        <p>Multiple attention heads run in parallel, allowing the model to focus on different aspects of the input simultaneously.</p>
                        <ul>
                            <li>8 heads in base Transformer</li>
                            <li>Each head has dimension d_k = d_model / h</li>
                            <li>Outputs are concatenated and projected</li>
                        </ul>`,
                        updatedAt: new Date(Date.now() - 172800000).toISOString(),
                        version: 1
                    }
                ];
                state.currentId = state.notes[0].id;
                saveState();
            }

            // ------------------------------------------------------------
            // STATE PERSISTENCE
            // ------------------------------------------------------------
            function loadState() {
                try {
                    const saved = localStorage.getItem(STORAGE_KEY);
                    if (saved) {
                        const parsed = JSON.parse(saved);
                        state.notes = parsed.notes || [];
                        state.currentId = parsed.currentId || null;
                        state.filter = parsed.filter || 'ALL';
                        state.theme = parsed.theme || 'cyber';
                        state.isSidebarCollapsed = parsed.isSidebarCollapsed || false;
                        state.versionMap = parsed.versionMap || {};
                        
                        // Ensure all notes have version property
                        state.notes.forEach(n => {
                            if (!n.version) n.version = 1;
                        });
                    }
                } catch (e) {
                    console.warn('Failed to load state:', e);
                }
            }

            function saveState() {
                try {
                    const data = {
                        notes: state.notes,
                        currentId: state.currentId,
                        filter: state.filter,
                        theme: state.theme,
                        isSidebarCollapsed: state.isSidebarCollapsed,
                        versionMap: state.versionMap
                    };
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
                } catch (e) {
                    console.warn('Failed to save state:', e);
                }
            }

            // ------------------------------------------------------------
            // NOTE CRUD
            // ------------------------------------------------------------
            function getCurrentNote() {
                return state.notes.find(n => n.id === state.currentId);
            }

            function getNoteIndex(id) {
                return state.notes.findIndex(n => n.id === id);
            }

            function createNewNote() {
                const newId = 'note-' + Date.now().toString(36) + '-' + Math.random().toString(36).substr(2, 4);
                const newNote = {
                    id: newId,
                    title: 'Untitled Neural Node',
                    category: 'GENERAL',
                    tags: '',
                    content: '<p>Begin your neural log...</p>',
                    updatedAt: new Date().toISOString(),
                    version: 1
                };

                state.notes.unshift(newNote);
                state.currentId = newId;
                saveState();
                renderNotesList();
                loadActiveNote();
                renderTagCloud();
                updateHUD();
                toast('New note initialized', 'success');
                focusEditor();
            }

            function saveCurrentNote() {
                const note = getCurrentNote();
                if (!note) return;

                const title = DOM.noteTitle.value.trim() || 'Untitled Neural Node';
                const content = DOM.noteBody.innerHTML;

                // Check if content actually changed
                if (note.title === title && note.content === content && note.category === DOM.noteCategory.value && note.tags === DOM.noteTags.value) {
                    return; // No change
                }

                // Save version history
                if (!state.versionMap[note.id]) {
                    state.versionMap[note.id] = [];
                }
                
                // Only save version if content changed significantly
                if (note.content !== content) {
                    state.versionMap[note.id].push({
                        content: note.content,
                        title: note.title,
                        timestamp: note.updatedAt
                    });
                    
                    // Trim versions
                    if (state.versionMap[note.id].length > MAX_VERSIONS) {
                        state.versionMap[note.id] = state.versionMap[note.id].slice(-MAX_VERSIONS);
                    }
                    
                    note.version = (note.version || 1) + 1;
                }

                note.title = title;
                note.category = DOM.noteCategory.value;
                note.tags = DOM.noteTags.value;
                note.content = content;
                note.updatedAt = new Date().toISOString();

                saveState();
                renderNotesList();
                renderTagCloud();
                updateHUD();
                updateStatus('SYNCHRONIZED', '');
            }

            function deleteCurrentNote() {
                const note = getCurrentNote();
                if (!note) return;

                state.notes = state.notes.filter(n => n.id !== state.currentId);
                
                if (state.notes.length > 0) {
                    state.currentId = state.notes[0].id;
                } else {
                    createNewNote();
                    return;
                }

                saveState();
                renderNotesList();
                loadActiveNote();
                renderTagCloud();
                updateHUD();
                toast('Note purged', 'info');
            }

            function loadActiveNote() {
                const note = getCurrentNote();
                if (!note) {
                    DOM.noteTitle.value = '';
                    DOM.noteCategory.value = 'GENERAL';
                    DOM.noteTags.value = '';
                    DOM.noteBody.innerHTML = '';
                    DOM.activeNoteId.innerText = '#----';
                    DOM.versionCount.innerText = '0';
                    return;
                }

                DOM.noteTitle.value = note.title;
                DOM.noteCategory.value = note.category || 'GENERAL';
                DOM.noteTags.value = note.tags || '';
                DOM.noteBody.innerHTML = note.content || '<p>Begin your neural log...</p>';
                DOM.activeNoteId.innerText = '#' + note.id.replace('note-', '').substr(0, 8);
                DOM.versionCount.innerText = note.version || 1;
                
                updateHUD();
            }

            // ------------------------------------------------------------
            // RENDER FUNCTIONS
            // ------------------------------------------------------------
            function renderNotesList() {
                const searchQuery = DOM.searchInput.value.toLowerCase().trim();
                
                const filtered = state.notes.filter(note => {
                    const matchesCategory = state.filter === 'ALL' || note.category === state.filter;
                    const matchesSearch = note.title.toLowerCase().includes(searchQuery) || 
                                         note.content.toLowerCase().includes(searchQuery) ||
                                         (note.tags && note.tags.toLowerCase().includes(searchQuery));
                    return matchesCategory && matchesSearch;
                });

                DOM.notesList.innerHTML = '';

                if (filtered.length === 0) {
                    DOM.notesList.innerHTML = `
                        <div style="text-align:center;padding:40px 10px;color:var(--text-muted);font-size:0.85rem;">
                            <i class="fa-solid fa-database" style="font-size:1.5rem;display:block;margin-bottom:10px;opacity:0.3;"></i>
                            ${searchQuery ? 'No matches found' : 'No notes. Create one!'}
                        </div>
                    `;
                    return;
                }

                filtered.forEach(note => {
                    const card = document.createElement('div');
                    card.className = `note-card ${note.id === state.currentId ? 'active' : ''}`;
                    
                    const temp = document.createElement('div');
                    temp.innerHTML = note.content;
                    const snippet = (temp.innerText || '').substring(0, 120) || 'No content...';
                    
                    const date = new Date(note.updatedAt);
                    const dateStr = date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                    
                    card.innerHTML = `
                        <div class="note-card-title">${escapeHtml(note.title)}</div>
                        <div class="note-card-snippet">${escapeHtml(snippet)}</div>
                        <div class="note-card-meta">
                            <span>${dateStr}</span>
                            <span class="note-tag-badge">${escapeHtml(note.category || 'GENERAL')}</span>
                        </div>
                    `;

                    card.addEventListener('click', () => {
                        // Save current note before switching
                        saveCurrentNote();
                        state.currentId = note.id;
                        renderNotesList();
                        loadActiveNote();
                        updateHUD();
                    });

                    card.addEventListener('dblclick', () => {
                        // Quick focus on editor
                        DOM.noteBody.focus();
                    });

                    DOM.notesList.appendChild(card);
                });
            }

            function renderTagCloud() {
                const tagMap = {};
                state.notes.forEach(note => {
                    if (note.tags) {
                        note.tags.split(',').forEach(tag => {
                            const t = tag.trim().toLowerCase();
                            if (t) {
                                tagMap[t] = (tagMap[t] || 0) + 1;
                            }
                        });
                    }
                });

                DOM.tagCloud.innerHTML = '';
                const sorted = Object.entries(tagMap).sort((a, b) => b[1] - a[1]).slice(0, 15);
                
                sorted.forEach(([tag, count]) => {
                    const chip = document.createElement('span');
                    chip.className = 'tag-chip';
                    chip.textContent = `${tag} (${count})`;
                    chip.addEventListener('click', () => {
                        DOM.searchInput.value = tag;
                        renderNotesList();
                    });
                    DOM.tagCloud.appendChild(chip);
                });
            }

            function updateHUD() {
                const note = getCurrentNote();
                if (!note) {
                    DOM.wordCount.innerText = '0';
                    DOM.charCount.innerText = '0';
                    return;
                }

                const text = DOM.noteBody.innerText || '';
                DOM.charCount.innerText = text.length;
                const words = text.trim().split(/\s+/).filter(w => w.length > 0);
                DOM.wordCount.innerText = text.trim() === '' ? 0 : words.length;
            }

            function updateStatus(message, icon) {
                DOM.saveStatus.innerText = message;
                DOM.statusDot.className = 'pulse-dot';
                if (icon === 'saving') {
                    DOM.statusDot.classList.add('saving');
                } else if (icon === 'error') {
                    DOM.statusDot.classList.add('error');
                }
            }

            // ------------------------------------------------------------
            // AUTO-SAVE ENGINE
            // ------------------------------------------------------------
            function triggerAutoSave() {
                clearTimeout(state.saveTimer);
                updateStatus('SAVING...', 'saving');
                
                state.saveTimer = setTimeout(() => {
                    saveCurrentNote();
                    updateStatus('SYNCHRONIZED', '');
                }, AUTO_SAVE_DELAY);
            }

            // ------------------------------------------------------------
            // THEME SYSTEM
            // ------------------------------------------------------------
            function applyTheme() {
                document.documentElement.setAttribute('data-theme', state.theme);
                const icon = DOM.themeToggle.querySelector('i');
                const themeNames = {
                    'cyber': 'moon',
                    'dark-minimal': 'sun',
                    'amber': 'fire'
                };
                icon.className = `fa-solid fa-${themeNames[state.theme] || 'moon'}`;
            }

            function cycleTheme() {
                const themes = ['cyber', 'dark-minimal', 'amber'];
                const idx = themes.indexOf(state.theme);
                state.theme = themes[(idx + 1) % themes.length];
                applyTheme();
                saveState();
                toast(`Theme: ${state.theme}`, 'info');
            }

            // ------------------------------------------------------------
            // FOCUS MODE
            // ------------------------------------------------------------
            function toggleFocusMode() {
                state.isFocusMode = !state.isFocusMode;
                DOM.editorBody.style.padding = state.isFocusMode ? '40px 80px' : '';
                DOM.editorBody.style.maxWidth = state.isFocusMode ? '800px' : '';
                DOM.formattingToolbar.style.display = state.isFocusMode ? 'none' : '';
                DOM.focusModeBtn.querySelector('i').className = state.isFocusMode ? 'fa-solid fa-compress' : 'fa-solid fa-expand';
                DOM.sidebar.style.display = state.isFocusMode ? 'none' : '';
                
                if (state.isFocusMode) {
                    DOM.noteBody.focus();
                }
            }

            // ------------------------------------------------------------
            // EXPORT
            // ------------------------------------------------------------
            function exportCurrentNote() {
                const note = getCurrentNote();
                if (!note) {
                    toast('No note to export', 'error');
                    return;
                }

                const html = `
                <!DOCTYPE html>
                <html>
                <head>
                    <title>${escapeHtml(note.title)}</title>
                    <meta charset="UTF-8">
                    <style>
                        body { 
                            font-family: 'Georgia', serif; 
                            max-width: 800px; 
                            margin: 40px auto; 
                            padding: 20px;
                            background: #0a0d12;
                            color: #d1d5db;
                            line-height: 1.8;
                        }
                        h1 { color: #00f2fe; border-bottom: 2px solid #00f2fe; padding-bottom: 10px; }
                        .meta { color: #8b949e; margin-bottom: 20px; font-family: monospace; }
                        blockquote { border-left: 3px solid #7f00ff; padding-left: 20px; color: #c084fc; }
                        pre { background: #1a1e24; padding: 16px; border-radius: 8px; overflow-x: auto; }
                        code { font-family: monospace; }
                        hr { border: none; border-top: 1px solid #2a2e34; margin: 30px 0; }
                        .footer { color: #484f58; font-size: 0.8rem; margin-top: 40px; text-align: center; }
                    </style>
                </head>
                <body>
                    <h1>${escapeHtml(note.title)}</h1>
                    <div class="meta">
                        <strong>Category:</strong> ${escapeHtml(note.category)} &bull; 
                        <strong>Tags:</strong> ${escapeHtml(note.tags)} &bull;
                        <strong>Version:</strong> ${note.version || 1} &bull;
                        <strong>Exported:</strong> ${new Date().toLocaleString()}
                    </div>
                    <hr>
                    ${note.content}
                    <hr>
                    <div class="footer">Exported from AETHER God Tier &bull; ${new Date().toISOString()}</div>
                </body>
                </html>
                `;

                const blob = new Blob([html], { type: 'text/html' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `${note.title.replace(/[^a-zA-Z0-9]/g, '_').substring(0, 50)}.html`;
                a.click();
                URL.revokeObjectURL(url);
                toast('Note exported', 'success');
            }

            // ------------------------------------------------------------
            // TOAST SYSTEM
            // ------------------------------------------------------------
            function toast(message, type = 'info', duration = 3000) {
                const el = document.createElement('div');
                el.className = `toast ${type}`;
                el.textContent = message;
                DOM.toastContainer.appendChild(el);
                
                setTimeout(() => {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(-10px)';
                    setTimeout(() => el.remove(), 300);
                }, duration);
            }

            // ------------------------------------------------------------
            // UTILITY
            // ------------------------------------------------------------
            function escapeHtml(str) {
                if (!str) return '';
                return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
            }

            function focusEditor() {
                DOM.noteBody.focus();
                // Place cursor at end
                const range = document.createRange();
                range.selectNodeContents(DOM.noteBody);
                range.collapse(false);
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);
            }

            // ------------------------------------------------------------
            // KEYBOARD SHORTCUTS
            // ------------------------------------------------------------
            function setupKeyboardShortcuts() {
                document.addEventListener('keydown', (e) => {
                    const ctrl = e.ctrlKey || e.metaKey;
                    const shift = e.shiftKey;

                    // Don't trigger shortcuts when typing in input fields (except specific ones)
                    const activeTag = document.activeElement?.tagName || '';
                    const isInput = ['INPUT', 'TEXTAREA', 'SELECT'].includes(activeTag);
                    const isContentEditable = document.activeElement?.contentEditable === 'true';

                    // Command Palette: Ctrl+K
                    if (ctrl && e.key === 'k') {
                        e.preventDefault();
                        toggleCommandPalette();
                        return;
                    }

                    // New Note: Ctrl+N
                    if (ctrl && e.key === 'n') {
                        e.preventDefault();
                        createNewNote();
                        return;
                    }

                    // Save: Ctrl+S
                    if (ctrl && e.key === 's') {
                        e.preventDefault();
                        saveCurrentNote();
                        toast('Saved manually', 'success');
                        return;
                    }

                    // Delete: Ctrl+Delete or Ctrl+Backspace
                    if (ctrl && (e.key === 'Delete' || e.key === 'Backspace')) {
                        e.preventDefault();
                        openDeleteModal();
                        return;
                    }

                    // Export: Ctrl+E
                    if (ctrl && e.key === 'e') {
                        e.preventDefault();
                        exportCurrentNote();
                        return;
                    }

                    // Search: Ctrl+F
                    if (ctrl && e.key === 'f') {
                        e.preventDefault();
                        DOM.searchInput.focus();
                        DOM.searchInput.select();
                        return;
                    }

                    // Focus Mode: Ctrl+Shift+F
                    if (ctrl && shift && e.key === 'F') {
                        e.preventDefault();
                        toggleFocusMode();
                        return;
                    }

                    // Escape: Close modals and command palette
                    if (e.key === 'Escape') {
                        if (DOM.deleteModal.classList.contains('active')) {
                            closeDeleteModal();
                        }
                        if (DOM.commandPalette.classList.contains('active')) {
                            closeCommandPalette();
                        }
                        return;
                    }

                    // Undo: Ctrl+Z (only in editor)
                    if (ctrl && e.key === 'z' && !e.shiftKey && isContentEditable) {
                        e.preventDefault();
                        document.execCommand('undo');
                        triggerAutoSave();
                        return;
                    }

                    // Redo: Ctrl+Shift+Z or Ctrl+Y
                    if ((ctrl && e.key === 'z' && shift) || (ctrl && e.key === 'y')) {
                        e.preventDefault();
                        document.execCommand('redo');
                        triggerAutoSave();
                        return;
                    }

                    // Navigation: Alt+Left/Right for previous/next note
                    if (!isInput && !isContentEditable && e.altKey) {
                        if (e.key === 'ArrowLeft') {
                            e.preventDefault();
                            navigateNote(-1);
                        } else if (e.key === 'ArrowRight') {
                            e.preventDefault();
                            navigateNote(1);
                        }
                    }
                });
            }

            function navigateNote(direction) {
                const idx = state.notes.findIndex(n => n.id === state.currentId);
                if (idx === -1) return;
                
                const newIdx = (idx + direction + state.notes.length) % state.notes.length;
                state.currentId = state.notes[newIdx].id;
                renderNotesList();
                loadActiveNote();
                updateHUD();
            }

            // ------------------------------------------------------------
            // COMMAND PALETTE
            // ------------------------------------------------------------
            function setupCommandPalette() {
                const commands = [
                    { id: 'new', label: 'New Note', icon: 'fa-plus', shortcut: '⌘N', action: createNewNote },
                    { id: 'save', label: 'Save Note', icon: 'fa-floppy-disk', shortcut: '⌘S', action: () => { saveCurrentNote(); toast('Saved', 'success'); } },
                    { id: 'export', label: 'Export Note', icon: 'fa-download', shortcut: '⌘E', action: exportCurrentNote },
                    { id: 'delete', label: 'Delete Note', icon: 'fa-trash', shortcut: '⌘⌫', action: openDeleteModal },
                    { id: 'focus', label: 'Toggle Focus Mode', icon: 'fa-expand', shortcut: '⌘⇧F', action: toggleFocusMode },
                    { id: 'theme', label: 'Cycle Theme', icon: 'fa-palette', shortcut: '', action: cycleTheme },
                ];

                DOM.commandInput.addEventListener('input', () => {
                    const query = DOM.commandInput.value.toLowerCase().trim();
                    const results = commands.filter(c => 
                        c.label.toLowerCase().includes(query) || 
                        c.id.includes(query)
                    );

                    // Add notes to results
                    const noteResults = state.notes
                        .filter(n => n.title.toLowerCase().includes(query))
                        .slice(0, 5)
                        .map(n => ({
                            id: 'note-' + n.id,
                            label: `📄 ${n.title}`,
                            icon: 'fa-file-lines',
                            shortcut: '',
                            action: () => {
                                state.currentId = n.id;
                                renderNotesList();
                                loadActiveNote();
                                updateHUD();
                                closeCommandPalette();
                            }
                        }));

                    const allResults = [...results, ...noteResults];
                    renderCommandResults(allResults);
                });

                DOM.commandInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        closeCommandPalette();
                        return;
                    }
                    
                    if (e.key === 'Enter') {
                        const selected = DOM.commandResults.querySelector('.selected');
                        if (selected) {
                            const idx = parseInt(selected.dataset.index);
                            const items = DOM.commandResults.querySelectorAll('.command-item');
                            if (items[idx]) {
                                const action = items[idx]._action;
                                if (action) action();
                                closeCommandPalette();
                            }
                        }
                    }

                    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                        e.preventDefault();
                        const items = DOM.commandResults.querySelectorAll('.command-item');
                        const current = DOM.commandResults.querySelector('.selected');
                        let idx = current ? parseInt(current.dataset.index) : -1;
                        idx = e.key === 'ArrowDown' ? Math.min(idx + 1, items.length - 1) : Math.max(idx - 1, 0);
                        items.forEach((el, i) => el.classList.toggle('selected', i === idx));
                    }
                });
            }

            function renderCommandResults(commands) {
                DOM.commandResults.innerHTML = '';
                commands.forEach((cmd, i) => {
                    const el = document.createElement('div');
                    el.className = `command-item ${i === 0 ? 'selected' : ''}`;
                    el.dataset.index = i;
                    el._action = cmd.action;
                    el.innerHTML = `
                        <i class="fa-solid ${cmd.icon}"></i>
                        <span>${cmd.label}</span>
                        ${cmd.shortcut ? `<span class="shortcut">${cmd.shortcut}</span>` : ''}
                    `;
                    el.addEventListener('click', () => {
                        if (cmd.action) cmd.action();
                        closeCommandPalette();
                    });
                    DOM.commandResults.appendChild(el);
                });
            }

            function toggleCommandPalette() {
                if (DOM.commandPalette.classList.contains('active')) {
                    closeCommandPalette();
                } else {
                    openCommandPalette();
                }
            }

            function openCommandPalette() {
                DOM.commandPalette.classList.add('active');
                DOM.commandInput.value = '';
                DOM.commandInput.focus();
                renderCommandResults([]);
                // Show default commands
                setTimeout(() => {
                    DOM.commandInput.dispatchEvent(new Event('input'));
                }, 50);
            }

            function closeCommandPalette() {
                DOM.commandPalette.classList.remove('active');
                DOM.commandInput.blur();
            }

            // ------------------------------------------------------------
            // FORMATTING TOOLBAR
            // ------------------------------------------------------------
            function setupFormattingToolbar() {
                DOM.formattingToolbar.querySelectorAll('.tool-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.preventDefault();
                        const command = btn.dataset.command;
                        const value = btn.dataset.value || null;

                        if (command === 'createLink') {
                            const url = prompt('Enter URL:', 'https://');
                            if (url) {
                                document.execCommand(command, false, url);
                            }
                        } else if (command === 'formatBlock') {
                            if (value === 'PRE') {
                                // Wrap in pre/code block
                                const selection = window.getSelection();
                                if (!selection.rangeCount) return;
                                const range = selection.getRangeAt(0);
                                const content = range.extractContents();
                                const pre = document.createElement('pre');
                                const code = document.createElement('code');
                                code.appendChild(content);
                                pre.appendChild(code);
                                range.insertNode(pre);
                            } else {
                                document.execCommand(command, false, value);
                            }
                        } else {
                            document.execCommand(command, false, value);
                        }
                        
                        DOM.noteBody.focus();
                        triggerAutoSave();
                    });
                });

                // Track active formatting state
                DOM.noteBody.addEventListener('mouseup', updateFormattingState);
                DOM.noteBody.addEventListener('keyup', updateFormattingState);
            }

            function updateFormattingState() {
                const commands = ['bold', 'italic', 'underline', 'strikeThrough'];
                commands.forEach(cmd => {
                    const btn = DOM.formattingToolbar.querySelector(`[data-command="${cmd}"]`);
                    if (btn) {
                        btn.classList.toggle('active', document.queryCommandState(cmd));
                    }
                });
            }

            // ------------------------------------------------------------
            // EVENT LISTENERS
            // ------------------------------------------------------------
            function setupEventListeners() {
                // Note title, category, tags changes
                DOM.noteTitle.addEventListener('input', triggerAutoSave);
                DOM.noteCategory.addEventListener('change', triggerAutoSave);
                DOM.noteTags.addEventListener('input', triggerAutoSave);
                DOM.noteBody.addEventListener('input', () => {
                    triggerAutoSave();
                    updateHUD();
                });

                // New note
                DOM.newNoteBtn.addEventListener('click', createNewNote);

                // Delete
                DOM.deleteNoteBtn.addEventListener('click', openDeleteModal);
                DOM.cancelDeleteBtn.addEventListener('click', closeDeleteModal);
                DOM.confirmDeleteBtn.addEventListener('click', () => {
                    deleteCurrentNote();
                    closeDeleteModal();
                });

                // Export
                DOM.exportBtn.addEventListener('click', exportCurrentNote);

                // Focus mode
                DOM.focusModeBtn.addEventListener('click', toggleFocusMode);

                // Theme
                DOM.themeToggle.addEventListener('click', cycleTheme);

                // Search
                DOM.searchInput.addEventListener('input', renderNotesList);

                // Category filters
                DOM.categoryFilters.querySelectorAll('.filter-chip').forEach(chip => {
                    chip.addEventListener('click', () => {
                        DOM.categoryFilters.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
                        chip.classList.add('active');
                        state.filter = chip.dataset.category;
                        renderNotesList();
                    });
                });

                // Sidebar toggle
                DOM.sidebarToggle.addEventListener('click', () => {
                    state.isSidebarCollapsed = !state.isSidebarCollapsed;
                    DOM.sidebar.classList.toggle('collapsed');
                    DOM.sidebarToggle.querySelector('i').className = state.isSidebarCollapsed ? 'fa-solid fa-chevron-right' : 'fa-solid fa-chevron-left';
                    saveState();
                });

                // Brand logo click - go to first note
                DOM.brandLogo.addEventListener('click', () => {
                    if (state.notes.length > 0) {
                        state.currentId = state.notes[0].id;
                        renderNotesList();
                        loadActiveNote();
                        updateHUD();
                    }
                });

                // Delete modal keyboard support
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && DOM.deleteModal.classList.contains('active')) {
                        closeDeleteModal();
                    }
                    if (e.key === 'Enter' && DOM.deleteModal.classList.contains('active')) {
                        deleteCurrentNote();
                        closeDeleteModal();
                    }
                });

                // Close modals on backdrop click
                DOM.deleteModal.addEventListener('click', (e) => {
                    if (e.target === DOM.deleteModal) closeDeleteModal();
                });

                // Click outside command palette to close
                document.addEventListener('click', (e) => {
                    if (DOM.commandPalette.classList.contains('active') && 
                        !DOM.commandPalette.contains(e.target) &&
                        !e.target.closest('.icon-btn')) {
                        closeCommandPalette();
                    }
                });

                // Window before unload - save
                window.addEventListener('beforeunload', () => {
                    saveCurrentNote();
                });

                // Handle paste for rich content
                DOM.noteBody.addEventListener('paste', (e) => {
                    // Allow paste but trigger save
                    setTimeout(triggerAutoSave, 50);
                });

                // Click on note body to focus
                DOM.noteBody.addEventListener('click', () => {
                    // Ensure we're focused
                });
            }

            // ------------------------------------------------------------
            // MODAL CONTROLS
            // ------------------------------------------------------------
            function openDeleteModal() {
                DOM.deleteModal.classList.add('active');
            }

            function closeDeleteModal() {
                DOM.deleteModal.classList.remove('active');
            }

            // ------------------------------------------------------------
            // BOOT
            // ------------------------------------------------------------
            // Wait for DOM fully loaded
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }

            // Expose for debugging
            window.__AETHER = {
                state,
                notes: () => state.notes,
                current: getCurrentNote,
                create: createNewNote,
                save: saveCurrentNote,
                export: exportCurrentNote,
                delete: deleteCurrentNote,
                toast
            };

        })();
    </script>
</body>
</html>
