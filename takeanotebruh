<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AETHER // GOD TIER - Cinematic Knowledge System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Fira+Code:wght@300;400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/dark.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
    
    <style>
        /* ============================================================
           ROOT VARIABLES & THEME SYSTEM
           ============================================================ */
        :root {
            --bg-base: #05070a;
            --bg-surface: rgba(13, 17, 23, 0.85);
            --bg-card: rgba(22, 27, 34, 0.6);
            --bg-card-hover: rgba(30, 38, 48, 0.8);
            --bg-modal: rgba(3, 5, 8, 0.92);
            
            --border-glow: rgba(0, 242, 254, 0.25);
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-active: rgba(0, 242, 254, 0.6);
            
            --neon-cyan: #00f2fe;
            --neon-blue: #4facfe;
            --neon-purple: #7f00ff;
            --neon-pink: #ff6b9d;
            --neon-amber: #ffb199;
            --neon-green: #00ff88;
            
            --text-primary: #f0f6fc;
            --text-secondary: #8b949e;
            --text-muted: #484f58;
            --text-inverse: #0a0d12;
            
            --font-cinzel: 'Cinzel', serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
            --font-mono: 'Fira Code', monospace;
            
            --sidebar-width: 340px;
            --sidebar-collapsed: 80px;
            --transition-smooth: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            --transition-bounce: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            
            --shadow-glow: 0 0 30px rgba(0, 242, 254, 0.1);
            --shadow-card: 0 4px 20px rgba(0, 0, 0, 0.4);
            
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;
        }

        /* Theme Variants */
        [data-theme="dark-minimal"] {
            --bg-base: #080b0f;
            --neon-cyan: #4facfe;
            --border-glow: rgba(79, 172, 254, 0.15);
            --shadow-glow: 0 0 30px rgba(79, 172, 254, 0.05);
        }

        [data-theme="amber"] {
            --bg-base: #0d0804;
            --neon-cyan: #ffb199;
            --neon-purple: #ff6b35;
            --border-glow: rgba(255, 177, 153, 0.2);
            --shadow-glow: 0 0 30px rgba(255, 177, 153, 0.08);
        }

        /* ============================================================
           RESET & BASE
           ============================================================ */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scrollbar-width: thin;
            scrollbar-color: var(--neon-cyan) var(--bg-base);
        }

        *::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        *::-webkit-scrollbar-track {
            background: var(--bg-base);
        }
        *::-webkit-scrollbar-thumb {
            background: linear-gradient(var(--neon-cyan), var(--neon-purple));
            border-radius: 10px;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: var(--font-body);
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            position: relative;
        }

        /* ============================================================
           AMBIENT EFFECTS
           ============================================================ */
        .cyber-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-image: 
                linear-gradient(to right, rgba(255,255,255,0.015) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.015) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
            z-index: 0;
        }

        .ambient-glow {
            position: fixed;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            filter: blur(140px);
            opacity: 0.12;
            pointer-events: none;
            z-index: 0;
            animation: floatGlow 20s ease-in-out infinite alternate;
        }
        .glow-1 { top: -200px; left: -100px; background: radial-gradient(circle, var(--neon-cyan), var(--neon-purple)); }
        .glow-2 { bottom: -200px; right: -100px; background: radial-gradient(circle, var(--neon-purple), var(--neon-blue)); animation-delay: -10s; }
        .glow-3 { top: 50%; left: 50%; transform: translate(-50%, -50%); width: 400px; height: 400px; background: radial-gradient(circle, var(--neon-pink), transparent); animation-delay: -5s; opacity: 0.05; }

        @keyframes floatGlow {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(80px, 50px) scale(1.1); }
            100% { transform: translate(-40px, 80px) scale(0.9); }
        }

        .scanline {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(
                to bottom,
                transparent 0px,
                transparent 3px,
                rgba(0,0,0,0.03) 3px,
                rgba(0,0,0,0.03) 4px
            );
            pointer-events: none;
            z-index: 999;
            opacity: 0.5;
        }

        .vignette {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.4) 100%);
            pointer-events: none;
            z-index: 1;
        }

        /* ============================================================
           APP LAYOUT
           ============================================================ */
        .app-wrapper {
            display: flex;
            width: 100vw;
            height: 100vh;
            z-index: 2;
            position: relative;
        }

        /* ============================================================
           SIDEBAR
           ============================================================ */
        .sidebar {
            width: var(--sidebar-width);
            min-width: var(--sidebar-width);
            background: var(--bg-surface);
            backdrop-filter: blur(20px);
            border-right: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            padding: 20px 16px;
            gap: 16px;
            transition: var(--transition-smooth);
            position: relative;
            z-index: 10;
            overflow: hidden;
        }

        .sidebar.collapsed {
            width: var(--sidebar-collapsed);
            min-width: var(--sidebar-collapsed);
        }
        .sidebar.collapsed .brand-logo span,
        .sidebar.collapsed .action-btn-main span,
        .sidebar.collapsed .search-box,
        .sidebar.collapsed .folder-filter-bar,
        .sidebar.collapsed .note-card-snippet,
        .sidebar.collapsed .note-card-meta,
        .sidebar.collapsed .note-card-title {
            display: none;
        }
        .sidebar.collapsed .note-card {
            padding: 10px;
            min-height: 20px;
        }
        .sidebar.collapsed .action-btn-main {
            padding: 12px;
            justify-content: center;
        }
        .sidebar.collapsed .brand-logo {
            justify-content: center;
            font-size: 1.2rem;
        }

        .sidebar-toggle {
            position: absolute;
            right: -12px;
            top: 50%;
            transform: translateY(-50%);
            width: 24px;
            height: 48px;
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: 0 8px 8px 0;
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition-smooth);
            z-index: 20;
        }
        .sidebar-toggle:hover {
            border-color: var(--neon-cyan);
            color: var(--neon-cyan);
            background: rgba(0, 242, 254, 0.05);
        }

        .brand-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .brand-logo {
            font-family: var(--font-cinzel);
            font-weight: 900;
            font-size: 1.4rem;
            letter-spacing: 3px;
            background: linear-gradient(135deg, #fff 0%, var(--neon-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            user-select: none;
        }
        .brand-logo i {
            color: var(--neon-cyan);
            font-size: 1.1rem;
            -webkit-text-fill-color: initial;
            text-shadow: 0 0 20px var(--neon-cyan);
        }

        .theme-toggle-btn {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            width: 32px;
            height: 32px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .theme-toggle-btn:hover {
            color: var(--neon-cyan);
            border-color: var(--neon-cyan);
        }

        /* Buttons */
        .action-btn-main {
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.12), rgba(127, 0, 255, 0.12));
            border: 1px solid var(--neon-cyan);
            color: var(--text-primary);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            font-family: var(--font-mono);
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 1px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: var(--transition-smooth);
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.05);
            text-transform: uppercase;
            white-space: nowrap;
        }
        .action-btn-main:hover {
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.25), rgba(127, 0, 255, 0.25));
            box-shadow: 0 0 35px rgba(0, 242, 254, 0.2);
            transform: translateY(-2px);
        }

        .search-box {
            position: relative;
        }
        .search-input {
            width: 100%;
            background: rgba(0,0,0,0.4);
            border: 1px solid var(--border-subtle);
            padding: 10px 14px 10px 38px;
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 0.85rem;
            outline: none;
            transition: var(--transition-smooth);
            font-family: var(--font-body);
        }
        .search-input:focus {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.1);
        }
        .search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        /* Category Filters */
        .folder-filter-bar {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding-bottom: 4px;
            flex-wrap: nowrap;
        }
        .filter-chip {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            cursor: pointer;
            white-space: nowrap;
            transition: var(--transition-smooth);
            font-family: var(--font-mono);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .filter-chip.active,
        .filter-chip:hover {
            background: rgba(0, 242, 254, 0.08);
            border-color: var(--neon-cyan);
            color: var(--neon-cyan);
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.05);
        }

        /* Tag Cloud */
        .tag-cloud {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            padding: 4px 0;
            max-height: 60px;
            overflow-y: auto;
        }
        .tag-chip {
            font-size: 0.6rem;
            padding: 2px 8px;
            border-radius: 12px;
            background: rgba(0, 242, 254, 0.05);
            border: 1px solid rgba(0, 242, 254, 0.1);
            color: var(--text-secondary);
            cursor: pointer;
            transition: var(--transition-smooth);
            font-family: var(--font-mono);
            text-transform: lowercase;
        }
        .tag-chip:hover {
            background: rgba(0, 242, 254, 0.15);
            color: var(--neon-cyan);
            border-color: var(--neon-cyan);
        }

        /* Notes List */
        .notes-list {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding-right: 4px;
        }

        .note-card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            padding: 12px 14px;
            cursor: pointer;
            transition: var(--transition-smooth);
            position: relative;
            overflow: hidden;
            min-height: 54px;
        }
        .note-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            background: transparent;
            transition: var(--transition-smooth);
        }
        .note-card:hover {
            background: var(--bg-card-hover);
            border-color: rgba(255,255,255,0.12);
            transform: translateX(4px);
        }
        .note-card.active {
            background: rgba(0, 242, 254, 0.04);
            border-color: var(--border-glow);
        }
        .note-card.active::before {
            background: var(--neon-cyan);
            box-shadow: 0 0 15px var(--neon-cyan);
        }
        .note-card-title {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-primary);
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .note-card-snippet {
            font-size: 0.75rem;
            color: var(--text-secondary);
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: 6px;
        }
        .note-card-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.65rem;
            color: var(--text-muted);
            font-family: var(--font-mono);
        }
        .note-tag-badge {
            font-size: 0.6rem;
            padding: 2px 8px;
            border-radius: 4px;
            background: rgba(255,255,255,0.04);
            color: var(--text-secondary);
            border: 1px solid var(--border-subtle);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ============================================================
           EDITOR
           ============================================================ */
        .editor-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: rgba(8, 11, 16, 0.5);
            backdrop-filter: blur(10px);
            position: relative;
            min-width: 0;
        }

        .editor-topbar {
            height: 60px;
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            background: rgba(13, 17, 23, 0.3);
            flex-shrink: 0;
            gap: 12px;
        }

        .status-indicator {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-secondary);
        }
        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--neon-cyan);
            box-shadow: 0 0 15px var(--neon-cyan);
            animation: pulse 2s infinite;
        }
        .pulse-dot.saving {
            animation: pulse 0.5s infinite;
            background-color: var(--neon-amber);
            box-shadow: 0 0 20px var(--neon-amber);
        }
        .pulse-dot.error {
            animation: pulse 0.3s infinite;
            background-color: #ff4757;
            box-shadow: 0 0 20px #ff4757;
        }

        @keyframes pulse {
            0% { opacity: 0.4; transform: scale(0.8); }
            50% { opacity: 1; transform: scale(1.2); }
            100% { opacity: 0.4; transform: scale(0.8); }
        }

        .editor-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-btn {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            width: 34px;
            height: 34px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition-smooth);
            position: relative;
        }
        .icon-btn:hover {
            color: var(--neon-cyan);
            border-color: var(--neon-cyan);
            background: rgba(0, 242, 254, 0.06);
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.1);
        }
        .icon-btn .tooltip {
            position: absolute;
            bottom: -28px;
            left: 50%;
            transform: translateX(-50%) scale(0.8);
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            padding: 2px 10px;
            border-radius: 4px;
            font-size: 0.6rem;
            color: var(--text-secondary);
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition-smooth);
        }
        .icon-btn:hover .tooltip {
            opacity: 1;
            transform: translateX(-50%) scale(1);
        }

        .shortcut-hint {
            font-size: 0.6rem;
            color: var(--text-muted);
            font-family: var(--font-mono);
            margin-left: 4px;
        }

        /* Editor Body */
        .editor-body {
            flex: 1;
            padding: 24px 40px;
            overflow-y: auto;
            max-width: 1000px;
            width: 100%;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .note-meta-inputs {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }
        .category-select,
        .tag-input-field {
            background: rgba(0,0,0,0.3);
            border: 1px solid var(--border-subtle);
            color: var(--neon-cyan);
            font-family: var(--font-mono);
            font-size: 0.7rem;
            padding: 6px 12px;
            border-radius: 4px;
            outline: none;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: var(--transition-smooth);
        }
        .category-select:focus,
        .tag-input-field:focus {
            border-color: var(--neon-cyan);
        }
        .tag-input-field {
            flex: 1;
            min-width: 120px;
            text-transform: none;
            color: var(--text-secondary);
        }

        .title-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            font-family: var(--font-cinzel);
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: 0.5px;
            padding-bottom: 10px;
            border-bottom: 2px solid transparent;
            transition: var(--transition-smooth);
        }
        .title-input:focus {
            border-bottom-color: var(--neon-cyan);
        }
        .title-input::placeholder {
            color: rgba(255,255,255,0.15);
        }

        /* Formatting Toolbar */
        .formatting-toolbar {
            display: flex;
            gap: 4px;
            padding: 6px 10px;
            background: rgba(18, 24, 33, 0.7);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            align-items: center;
            flex-wrap: wrap;
            backdrop-filter: blur(8px);
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .tool-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            width: 30px;
            height: 30px;
            border-radius: 4px;
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }
        .tool-btn:hover {
            color: var(--text-primary);
            background: rgba(255,255,255,0.06);
        }
        .tool-btn.active {
            color: var(--neon-cyan);
            background: rgba(0, 242, 254, 0.08);
        }
        .tool-divider {
            width: 1px;
            height: 20px;
            background: var(--border-subtle);
            margin: 0 4px;
        }

        /* Content Area */
        .content-area {
            flex: 1;
            outline: none;
            font-size: 1.05rem;
            line-height: 1.8;
            color: #d1d5db;
            min-height: 300px;
            padding: 4px 0;
        }
        .content-area:empty::before {
            content: 'Begin your neural log...';
            color: var(--text-muted);
            opacity: 0.5;
        }
        .content-area p { margin-bottom: 1.2em; }
        .content-area h1, .content-area h2, .content-area h3 {
            color: var(--text-primary);
            font-family: var(--font-cinzel);
            margin: 1.5em 0 0.5em 0;
            letter-spacing: 0.5px;
        }
        .content-area h2 {
            font-size: 1.3rem;
            border-left: 3px solid var(--neon-cyan);
            padding-left: 14px;
            color: #fff;
        }
        .content-area h3 {
            font-size: 1.1rem;
            color: var(--neon-cyan);
        }
        .content-area blockquote {
            border-left: 3px solid var(--neon-purple);
            background: rgba(127, 0, 255, 0.04);
            padding: 12px 20px;
            margin: 1.2em 0;
            font-style: italic;
            color: #c084fc;
            border-radius: 0 8px 8px 0;
        }
        .content-area pre {
            background: rgba(0,0,0,0.5);
            border: 1px solid var(--border-subtle);
            padding: 16px;
            border-radius: var(--radius-sm);
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--neon-cyan);
            overflow-x: auto;
            margin: 1.2em 0;
        }
        .content-area code {
            font-family: var(--font-mono);
            font-size: 0.9em;
            background: rgba(0,0,0,0.3);
            padding: 2px 6px;
            border-radius: 3px;
            color: var(--neon-cyan);
        }
        .content-area ul, .content-area ol {
            padding-left: 24px;
            margin-bottom: 1.2em;
        }
        .content-area li { margin-bottom: 6px; }
        .content-area a {
            color: var(--neon-cyan);
            text-decoration: none;
            border-bottom: 1px dashed var(--neon-cyan);
        }
        .content-area a:hover { opacity: 0.7; }

        /* ============================================================
           HUD STATS
           ============================================================ */
        .hud-stats {
            position: absolute;
            bottom: 16px;
            right: 24px;
            background: rgba(13, 17, 23, 0.85);
            border: 1px solid var(--border-subtle);
            backdrop-filter: blur(12px);
            padding: 6px 16px;
            border-radius: 20px;
            display: flex;
            gap: 16px;
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--text-secondary);
            box-shadow: var(--shadow-card);
            pointer-events: none;
            z-index: 5;
        }
        .hud-stat-item span {
            color: var(--neon-cyan);
            font-weight: 600;
        }

        /* ============================================================
           MODAL
           ============================================================ */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: var(--bg-modal);
            backdrop-filter: blur(12px);
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition-smooth);
        }
        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .cyber-modal {
            background: var(--bg-surface);
            border: 1px solid var(--neon-cyan);
            box-shadow: 0 0 50px rgba(0, 242, 254, 0.1);
            width: 460px;
            max-width: 90vw;
            padding: 32px;
            border-radius: var(--radius-lg);
            transform: scale(0.9) translateY(20px);
            transition: var(--transition-bounce);
        }
        .modal-overlay.active .cyber-modal {
            transform: scale(1) translateY(0);
        }

        .modal-title {
            font-family: var(--font-cinzel);
            font-size: 1.2rem;
            color: var(--text-primary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .modal-title i { color: var(--neon-cyan); }
        .modal-body {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 24px;
        }
        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .btn-secondary {
            background: transparent;
            border: 1px solid var(--border-subtle);
            color: var(--text-primary);
            padding: 8px 20px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            transition: var(--transition-smooth);
        }
        .btn-secondary:hover {
            border-color: var(--text-secondary);
        }
        .btn-danger {
            background: rgba(255, 71, 87, 0.15);
            border: 1px solid #ff4757;
            color: #ff4757;
            padding: 8px 20px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            transition: var(--transition-smooth);
        }
        .btn-danger:hover {
            background: #ff4757;
            color: #fff;
            box-shadow: 0 0 25px rgba(255, 71, 87, 0.3);
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-blue));
            border: none;
            color: var(--text-inverse);
            padding: 8px 20px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 600;
            transition: var(--transition-smooth);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(0, 242, 254, 0.3);
        }

        /* ============================================================
           COMMAND PALETTE
           ============================================================ */
        .command-palette {
            position: fixed;
            top: 80px;
            left: 50%;
            transform: translateX(-50%) scale(0.95);
            width: 600px;
            max-width: 90vw;
            max-height: 60vh;
            background: var(--bg-surface);
            border: 1px solid var(--border-glow);
            border-radius: var(--radius-lg);
            box-shadow: 0 20px 60px rgba(0,0,0,0.8);
            backdrop-filter: blur(20px);
            z-index: 3000;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition-smooth);
            overflow: hidden;
        }
        .command-palette.active {
            opacity: 1;
            pointer-events: auto;
            transform: translateX(-50%) scale(1);
        }
        .command-palette input {
            width: 100%;
            padding: 16px 20px;
            background: transparent;
            border: none;
            border-bottom: 1px solid var(--border-subtle);
            color: var(--text-primary);
            font-size: 1rem;
            font-family: var(--font-body);
            outline: none;
        }
        .command-palette input::placeholder {
            color: var(--text-muted);
        }
        .command-results {
            overflow-y: auto;
            max-height: calc(60vh - 60px);
            padding: 8px;
        }
        .command-item {
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-secondary);
            transition: var(--transition-smooth);
        }
        .command-item:hover,
        .command-item.selected {
            background: rgba(0, 242, 254, 0.06);
            color: var(--text-primary);
        }
        .command-item i {
            width: 20px;
            color: var(--neon-cyan);
        }
        .command-item .shortcut {
            margin-left: auto;
            font-size: 0.65rem;
            color: var(--text-muted);
            font-family: var(--font-mono);
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 900px) {
            .sidebar {
                width: var(--sidebar-collapsed);
                min-width: var(--sidebar-collapsed);
                padding: 16px 10px;
            }
            .sidebar .brand-logo span,
            .sidebar .action-btn-main span,
            .sidebar .search-box,
            .sidebar .folder-filter-bar,
            .sidebar .note-card-snippet,
            .sidebar .note-card-meta,
            .sidebar .note-card-title {
                display: none;
            }
            .sidebar .action-btn-main {
                padding: 12px;
                justify-content: center;
            }
            .sidebar .brand-logo {
                justify-content: center;
                font-size: 1.2rem;
            }
            .sidebar .note-card {
                padding: 10px;
                min-height: 20px;
            }
            .editor-body {
                padding: 16px 20px;
            }
            .hud-stats {
                display: none;
            }
            .formatting-toolbar {
                gap: 2px;
                padding: 4px 6px;
            }
            .tool-btn {
                width: 26px;
                height: 26px;
                font-size: 0.7rem;
            }
            .title-input {
                font-size: 1.4rem;
            }
            .note-meta-inputs {
                gap: 8px;
            }
            .command-palette {
                top: 40px;
                width: 95vw;
            }
        }

        @media (max-width: 480px) {
            .editor-topbar {
                padding: 0 12px;
                height: 50px;
            }
            .status-indicator span {
                font-size: 0.6rem;
            }
            .editor-body {
                padding: 12px 14px;
            }
            .content-area {
                font-size: 0.95rem;
                line-height: 1.6;
            }
            .sidebar-toggle {
                display: none;
            }
        }

        /* ============================================================
           LOADING SKELETON
           ============================================================ */
        .skeleton {
            background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-card-hover) 50%, var(--bg-card) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: var(--radius-sm);
        }
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        /* ============================================================
           TOAST NOTIFICATIONS
           ============================================================ */
        .toast-container {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 5000;
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: center;
            pointer-events: none;
        }
        .toast {
            background: var(--bg-surface);
            border: 1px solid var(--border-glow);
            padding: 10px 24px;
            border-radius: var(--radius-sm);
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-secondary);
            box-shadow: var(--shadow-card);
            backdrop-filter: blur(12px);
            animation: toastIn 0.3s ease-out;
            pointer-events: auto;
        }
        .toast.success { border-color: var(--neon-green); color: var(--neon-green); }
        .toast.error { border-color: #ff4757; color: #ff4757; }
        .toast.info { border-color: var(--neon-cyan); color: var(--neon-cyan); }

        @keyframes toastIn {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
    </style>
</head>
<body>

    <!-- ============================================================
         AMBIENT LAYERS
         ============================================================ -->
    <div class="cyber-grid"></div>
    <div class="vignette"></div>
    <div class="scanline"></div>
